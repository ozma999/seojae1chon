# 국립중앙도서관 ISBN 서지정보 API 인증키(서버 전용, 선택). 있으면 가장 먼저 찾는다.
NL_API_KEY=
# 구글 북스 API 키(서버 전용). 키 없이는 공용 사용량이 금방 바닥나 검색이 안 될 수 있다. 무료(하루 1,000회).
GOOGLE_BOOKS_KEY=
